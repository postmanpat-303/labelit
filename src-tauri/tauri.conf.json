{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Label-IT",
  "version": "0.1.5",
  "identifier": "app.labelit.editor",
  "build": {
    "beforeBuildCommand": "node build-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Label-IT",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://cdn.buymeacoffee.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
